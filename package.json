{
  "name": "amber-hq",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run packages/core/src/task/supabase-task-repository.integration.test.ts packages/input/src/input-service.integration.test.ts apps/discord-worker/src/discord-message-adapter.integration.test.ts packages/google-calendar/src/supabase-calendar-sync-repository.integration.test.ts packages/icloud-calendar/src/supabase-calendar-sync-repository.integration.test.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > supabase/database.types.ts",
    "discord:dev": "pnpm --filter @amber/discord-worker dev",
    "calendar:auth": "pnpm --filter @amber/google-calendar auth",
    "calendar:sync": "pnpm --filter @amber/google-calendar sync",
    "calendar:icloud:sync": "pnpm --filter @amber/icloud-calendar sync"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "24.3.0",
    "eslint": "9.35.0",
    "supabase": "2.116.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4"
  }
}
