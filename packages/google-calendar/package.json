{
  "name": "@amber/google-calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "auth": "tsc -b && node --enable-source-maps dist/auth-cli.js",
